# Paytm Bazaar — environment configuration
#
# Copy to .env.local and fill in what you actually have:
#
#   cp .env.example .env.local
#
# Nothing below is required to start the app. Every integration is optional at
# startup; a feature that needs one reports a clear error when it is missing,
# and the rest of the product keeps working.
#
# Never commit real credentials. .env* is gitignored.

# --- How much of Bazaar is switched on -------------------------------------
# deterministic (default): Supabase, the Data Adapter, M2M and Relevance only.
#   Every figure is calculated and every word is written from those figures by
#   fixed rules. No LLM, no Cognee, no n8n, no voice — the keys below are
#   ignored, so a deployment cannot quietly start calling a paid provider.
# full: use every integration configured below.
#
# Set both when switching: the server reads BAZAAR_MODE, and the browser reads
# NEXT_PUBLIC_BAZAAR_MODE (inlined at build time) to label the System Flow.
# BAZAAR_MODE=full
# NEXT_PUBLIC_BAZAAR_MODE=full

# --- Database (Supabase / PostgreSQL) -------------------------------------
# Needed once a feature reads or writes the database.
# Dashboard: Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe in the browser — it has no
# privileges of its own; Row Level Security decides what it can reach.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Server-only. Bypasses Row Level Security.
# Never expose this, never prefix it with NEXT_PUBLIC_, never commit it.
SUPABASE_SECRET_KEY=

# Direct Postgres connection, only for applying migrations (scripts, Flyway).
# Supabase: Connect (top bar) -> Session pooler -> URI. The app never uses it.
# postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- LLM provider ---------------------------------------------------------
# Needed only by LLM-dependent features (Ask Bazaar, the AI summary). The M2M
# engine never uses an LLM.
# Implemented: "sarvam" (Sarvam 105B, default) and "openrouter".
# The fallback is used when the primary is unconfigured or fails
# (default: openrouter when the primary is sarvam; "none" disables it).
LLM_PROVIDER=sarvam
LLM_FALLBACK_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Optional: override the default model.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# --- Contextual memory (Cognee) — optional --------------------------------
# Merchant memory (past situations, recommendations, actions, outcomes).
# Both COGNEE_API_KEY and COGNEE_TENANT_ID are needed; from the Cognee Cloud
# dashboard. Cloud defaults to https://api.cognee.ai. Override for self-hosted Cognee.
# Without them, insights are generated without history.
COGNEE_API_KEY=
COGNEE_BASE_URL=https://api.cognee.ai
COGNEE_TENANT_ID=

# --- Action orchestration (n8n) — optional --------------------------------
# Base URL is your n8n instance, for example https://example.app.n8n.cloud.
# Approved actions are POSTed to ${N8N_BASE_URL}/webhook/bazaar-merchant-action:
# import n8n/workflows/bazaar-merchant-action.json and activate it.
# N8N_API_KEY is only used for the connection check (n8n Settings -> n8n API).
N8N_BASE_URL=
N8N_API_KEY=
# Optional: full webhook URL, if it is not ${N8N_BASE_URL}/webhook/bazaar-merchant-action.
N8N_WEBHOOK_URL=
# Optional: sent as the X-Bazaar-Secret header; set the workflow's Header Auth
# credential to the same name and value.
N8N_WEBHOOK_SECRET=
# Server-controlled addresses used by the imported email workflow. For the
# hackathon, point the recipient at a consented demo inbox. Neither value is
# exposed to the browser or LLM.
N8N_EMAIL_FROM=
N8N_EMAIL_RECIPIENT=

# --- Sarvam AI (Ask Bazaar chat, voice input, spoken answers) ---------------
# Server-only. From https://dashboard.sarvam.ai. Without it, chat falls back
# to OpenRouter (or a summary built from the facts) and voice is unavailable.
# See docs/ask-bazaar.md.
SARVAM_API_KEY=
# Optional second Sarvam account. Used automatically when the primary is out
# of credits, rate-limited or rejected (401/402/403/429); the primary is then
# skipped for 15 minutes before it is tried again.
SARVAM_API_KEY_BACKUP=
# Optional overrides (defaults shown).
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=shubh
# SARVAM_BASE_URL=https://api.sarvam.ai
