# Paytm Bazaar — environment configuration
#
# Copy to .env.local and fill in what you actually have:
#
#   cp .env.example .env.local
#
# Nothing below is required to start the app. Every integration is optional at
# startup; a feature that needs one reports a clear error when it is missing,
# and the rest of the product keeps working.
#
# Never commit real credentials. .env* is gitignored.

# --- Database (Supabase / PostgreSQL) -------------------------------------
# Needed once a feature reads or writes the database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM provider ---------------------------------------------------------
# Needed only by LLM-dependent features (e.g. Ask Bazaar). The M2M engine
# never uses an LLM.
# Currently the only implemented provider is "openrouter".
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Optional: override the default model.
OPENROUTER_MODEL=

# --- Contextual memory (Cognee) — optional --------------------------------
# Not implemented yet. The app runs without it.
COGNEE_API_KEY=

# --- Action orchestration (n8n) — optional --------------------------------
# Not implemented yet. Without it, insights still work; only actions fail.
N8N_BASE_URL=
N8N_API_KEY=

# --- Sarvam AI — not integrated -------------------------------------------
# No confirmed access. Listed so the slot is known, not because it is wired up.
# SARVAM_API_KEY=
